{
  "name": "pi-codex-bash",
  "version": "1.0.0",
  "description": "Codex-shaped shell tool and prompt adapter for pi coding agent",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "codex",
    "adapter",
    "bash",
    "shell"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuraxii/pi-codex-bash.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "build:changed-native-tools": "node scripts/build-changed-native-tool-binaries.mjs",
    "build:native-tool": "node scripts/build-native-tool-binary.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.82.0",
    "@earendil-works/pi-coding-agent": ">=0.82.0",
    "@earendil-works/pi-tui": ">=0.82.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "tsx": "^4.20.5",
    "typebox": "1.3.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.26.7"
  },
  "kuraxii": {
    "type": "extension",
    "tags": [
      "core",
      "shell"
    ]
  }
}
